#!/usr/bin/env bash
# Claude Code statusline: model · dir · elevator-music now-playing.
# Reads session JSON on stdin; emits one line.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
EM="$SCRIPT_DIR/elevator-music"
STATE_DIR="${ELEVATOR_MUSIC_STATE_DIR:-$HOME/.claude/elevator-music}"
CHILD_PID_FILE="$STATE_DIR/player.child"
LAST_TRACK_FILE="$STATE_DIR/last_track"
PID_FILE="$STATE_DIR/player.pid"
DISABLED_FLAG="$STATE_DIR/disabled"

input=$(cat 2>/dev/null || true)

model="Claude"
dir="$PWD"
if [[ -n "$input" ]] && command -v jq >/dev/null 2>&1; then
  m=$(printf '%s' "$input" | jq -r '.model.display_name // empty' 2>/dev/null)
  d=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty' 2>/dev/null)
  [[ -n "$m" ]] && model="$m"
  [[ -n "$d" ]] && dir="$d"
fi
dir_short="$(basename "$dir")"

music_segment=""
if [[ -e "$DISABLED_FLAG" ]]; then
  music_segment=" │ 🔇 elevator-music off"
else
  cpid=$(cat "$CHILD_PID_FILE" 2>/dev/null || true)
  if [[ -n "${cpid:-}" ]] && kill -0 "$cpid" 2>/dev/null; then
    track=$(cat "$LAST_TRACK_FILE" 2>/dev/null || true)
    pretty=$("$EM" pretty "$track" 2>/dev/null || printf '%s' "$track")
    pretty="${pretty%$'\n'}"
    glyphs=('🎵' '♫' '♬' '♪')
    idx=$(( $(date +%s) % 4 ))
    glyph="${glyphs[$idx]}"
    music_segment=" │ ${glyph} ${pretty}"
  else
    # Loop alive but no active player → inside the 1s pre-roll
    lpid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "${lpid:-}" ]] && kill -0 "$lpid" 2>/dev/null; then
      music_segment=" │ 🎼 cueing up…"
    fi
  fi
fi

printf '[%s] 📁 %s%s\n' "$model" "$dir_short" "$music_segment"
